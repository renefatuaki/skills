<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- All configurations have root module Checker. -->
<module name="Checker">
  <!-- Checks for long lines. -->
  <module name="LineLength">
    <!-- Specify the file extensions of the files to process. -->
    <property name="fileExtensions" value="java"/>
    <!-- Specify the maximum line length allowed. -->
    <property name="max" value="100"/>
  </module>
  <!-- File Set Check TreeWalker checks individual Java source files and defines properties that are applicable to checking such files. -->
  <module name="TreeWalker">
    <!-- Checks for braces around code blocks. -->
    <module name="NeedBraces"/>
    <!-- Checks the number of parameters of a method or constructor. -->
    <module name="ParameterNumber">
      <!-- Specify the maximum number of parameters allowed. -->
      <property name="max" value="4"/>
    </module>
    <!-- Checks that array initialization contains a trailing comma. -->
    <module name="ArrayTrailingComma"/>
    <!-- Checks for empty line separators after, fields, constructors, methods, nested classes, static initializers and instance initializers. -->
    <module name="EmptyLineSeparator">
      <!-- Allow no empty line between fields. -->
      <property name="allowNoEmptyLineBetweenFields" value="true"/>
    </module>
  </module>
</module>
