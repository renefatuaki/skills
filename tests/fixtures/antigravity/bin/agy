#!/usr/bin/env node

// Stands in for `agy`. `agy models` lists model-list.txt, and `agy -p /usage` answers as FAKE_AGY_USAGE names.

const { readFileSync } = require('node:fs');
const { join } = require('node:path');

const args = process.argv.slice(2);
const kind = process.env.FAKE_AGY_CASE;
const usageKind = process.env.FAKE_AGY_USAGE;

const listText = readFileSync(join(__dirname, '..', 'model-list.txt'), 'utf8');

if (args[0] === 'models') {
  if (kind === 'signed-out') {
    console.error('error: not signed in, run agy to sign in');
    process.exit(1);
  }

  console.error('Fetching available models...');
  process.stdout.write(listText);
  process.exit(0);
}

const bucket = (window, fraction) => ({
  id: `${window}-limit`,
  name: 'Limit Remaining',
  window,
  remaining_fraction: fraction,
  reset_time: '2026-11-06T15:01:23Z',
});

const group = (name, models, buckets) => ({
  name,
  description: models === '' ? 'Shared by all models.' : `Models within this group: ${models}`,
  buckets,
});

// The group of Claude and GPT models is always tight, so a case shows that it never gates a Gemini run.
const otherGroup = group('Claude and GPT models', 'Claude Opus, Claude Sonnet, GPT-OSS', [bucket('weekly', 0.05)]);

const geminiGroup = fraction => group('Gemini Models', 'Gemini Flash, Gemini Pro', [bucket('weekly', fraction)]);

const usageGroups = {
  enough: [geminiGroup(0.92), otherGroup],
  below: [geminiGroup(0.15), otherGroup],
  exactly: [geminiGroup(0.2), otherGroup],
  'argon-group': [geminiGroup(0.92), group('Gemini Argon', 'Gemini Argon', [bucket('weekly', 0.1)]), otherGroup],
  plain: [group('Gemini Models', '', [bucket('weekly', 0.1)]), otherGroup],
  buckets: [group('Gemini Models', 'Gemini Flash, Gemini Pro', [bucket('daily', 0.9), bucket('weekly', 0.1)]), otherGroup],
  'no-gemini': [otherGroup],
}[usageKind ?? 'enough'];

if (args[0] === '-p' && args[1] === '/usage') {
  if (usageKind === 'fails') {
    console.error('error: quota service unreachable');
    console.log(JSON.stringify({ status: 'ERROR', response: '', error: 'quota service unreachable' }));
    process.exit(1);
  }

  if (usageKind === 'garbage') {
    console.log('not json');
    process.exit(0);
  }

  const data = { description: 'Within each group, models share a weekly limit.', groups: usageGroups };

  console.log(JSON.stringify({ conversation_id: '', status: 'SUCCESS', response: 'tsv text\n', command: { name: 'usage', data } }));
  process.exit(0);
}

console.error(`error: unexpected arguments ${args.join(' ')}`);
process.exit(2);
