#!/usr/bin/env node

// Stands in for `agy`. `agy models` lists model-list.txt, and `agy -p` answers in the JSON line of --output-format json as the case FAKE_AGY_CASE names.

const { readFileSync } = require('node:fs');
const { join } = require('node:path');

const args = process.argv.slice(2);
const kind = process.env.FAKE_AGY_CASE;

if (args[0] === 'models') {
  if (kind === 'signed-out') {
    console.error('error: not signed in, run agy to sign in');
    process.exit(1);
  }

  console.log('Fetching available models...');
  process.stdout.write(readFileSync(join(__dirname, '..', 'model-list.txt'), 'utf8'));
  process.exit(0);
}

// The script passes these flags in this order, each followed by its value, and --effort last. Any other flag fails.
const flags = args.filter((_, index) => index % 2 === 0).join(' ');

if (!/^-p --output-format --model --print-timeout( --effort)?$/.test(flags)) {
  console.error(`error: unexpected arguments ${flags}`);
  process.exit(2);
}

const [, brief, , , , model, , timeout, , effort] = args;

// An id that ends in an effort fails on any --effort, as the real CLI does.
if (effort !== undefined && /-(high|medium|low)$/.test(model)) {
  console.error(`error: --model ${model} conflicts with --effort=${effort}`);
  process.exit(1);
}

const outcome = {
  error: { status: 'ERROR', error: 'quota exceeded', finished_reason: 'error', exit: 1 },
  timeout: { status: 'SUCCESS', response: 'Half an answer.\n', finished_reason: 'print_timeout', exit: 0 },
  denied: { status: 'SUCCESS', response: '', denied_actions: [{ action: 'write_file' }], exit: 0 },
  'denied-with-answer': {
    status: 'SUCCESS',
    response: 'Found two issues.\n',
    denied_actions: [{ action: 'write_file' }, { action: 'write_file' }],
    exit: 0,
  },
}[kind] ?? { status: 'SUCCESS', response: `answer from ${model}${effort === undefined ? '' : ` with effort ${effort}`} in ${timeout}: ${brief}\n`, exit: 0 };

if (kind === 'noise') {
  console.error('panic: agy lost its connection');
  console.log('not json');
  process.exit(1);
}

if (kind === 'denied') {
  console.error('jetski: no output produced, a tool required the "write_file" permission');
}

const { exit, ...answer } = outcome;

console.log(JSON.stringify({ conversation_id: 'fake', ...answer, num_turns: 1 }));
process.exit(exit);
