{
  "name": "skills",
  "private": true,
  "description": "Claude Code plugins for a GitHub workflow and for clean code, in one marketplace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/renefatuaki/skills"
  },
  "scripts": {
    "test": "node tests/code-comments.test.mts && node tests/project-docs.test.mts && node tests/diagrams.test.mts",
    "version": "changeset version && node scripts/sync-plugin-version.mts",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "markdownlint": "^0.41.1",
    "mermaid": "11.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
